{
  "name": "@codecrab/dsh-opencode-usage",
  "version": "0.1.0",
  "description": "DeepSeek Harness 提供方用量插件：在模型切换器旁查看 OpenCode Go 套餐额度（5 小时/周/月）、DeepSeek 官方余额或自定义 HTTP 用量接口。Provider usage quota plugin for DeepSeek Harness.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./typert": {
      "default": "./lib/typert.host.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "dsh": ">=0.2.0 <0.3.0"
  },
  "files": [
    "lib/index.js",
    "lib/service.js",
    "lib/queries.js",
    "lib/store.js",
    "lib/messages.js",
    "lib/provider-alias.js",
    "lib/typert.host.js",
    "lib/client.js",
    "lib/client-src",
    "scripts",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh-CN.md"
  ],
  "scripts": {
    "test": "node --test",
    "check": "node scripts/check.mjs",
    "build:client": "node scripts/build-client.mjs",
    "dev:client": "node scripts/build-client.mjs --watch"
  },
  "dependencies": {
    "@deepseek-ai/dsh-credentials": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-home-paths": "^0.1.0-rc.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "client-plugin",
    "usage",
    "quota",
    "opencode",
    "billing"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "MIT"
}
